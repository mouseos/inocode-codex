{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InocodeGuardOrigin": {
      "properties": {
        "kind": {
          "description": "`ledger`, `ui` or `legacy`.",
          "type": "string"
        },
        "missing": {
          "default": false,
          "description": "The referenced user message is no longer in the ledger.",
          "type": "boolean"
        },
        "quote": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "threadId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "InocodeGuardResult": {
      "enum": [
        "blocked",
        "warned"
      ],
      "type": "string"
    },
    "InocodeKnowledgeScope": {
      "enum": [
        "project",
        "global"
      ],
      "type": "string"
    },
    "InocodeRuleSeverity": {
      "enum": [
        "block",
        "warn"
      ],
      "type": "string"
    }
  },
  "description": "Same shape as `InocodeGuardEvent`; sent when a guard rule fires.",
  "properties": {
    "availableScopes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/definitions/InocodeGuardOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "type": "string"
    },
    "result": {
      "$ref": "#/definitions/InocodeGuardResult"
    },
    "ruleId": {
      "type": "string"
    },
    "ruleTitle": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/definitions/InocodeKnowledgeScope"
    },
    "severity": {
      "$ref": "#/definitions/InocodeRuleSeverity"
    },
    "target": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "toolUseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "tsMs": {
      "format": "int64",
      "type": "integer"
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "reason",
    "result",
    "ruleId",
    "ruleTitle",
    "scope",
    "severity",
    "target",
    "threadId",
    "tool",
    "tsMs"
  ],
  "title": "InocodeGuardFiredNotification",
  "type": "object"
}