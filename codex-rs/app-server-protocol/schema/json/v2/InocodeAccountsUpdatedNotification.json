{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "InocodeAccount": {
      "description": "One pool entry. There is deliberately no e-mail address: identify by `alias` and `plan`.",
      "properties": {
        "alias": {
          "description": "User-chosen name.",
          "type": "string"
        },
        "cooldownUntil": {
          "description": "Unix seconds; set while `state` is `cooldown`.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "deepai": {
          "anyOf": [
            {
              "$ref": "#/definitions/InocodeAccountDeepAi"
            },
            {
              "type": "null"
            }
          ],
          "description": "DeepAI entries only: the sign-in's identity and the Theos balance. Absent for other providers."
        },
        "email": {
          "description": "The account's e-mail address, from the sign-in (ChatGPT: ID token; Claude: profile). `null` when unknown. Local only; shown on the account screen.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "inUse": {
          "description": "True for the entry used by the next request.",
          "type": "boolean"
        },
        "isDefault": {
          "description": "True for the legacy `auth.json` login shown as the default account.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/InocodeAccountKind"
        },
        "lastUsedAt": {
          "description": "Unix seconds.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "The owner's display name; `null` when unknown.",
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "description": "Plan name for ChatGPT accounts (for example `plus`, `pro`); `null` for API keys.",
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "description": "Larger is used earlier.",
          "format": "int32",
          "type": "integer"
        },
        "provider": {
          "description": "Provider group the entry belongs to: `openai` or `claude`.",
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/InocodeAccountState"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/InocodeAccountUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` for API keys (no usage concept) or before the first fetch."
        }
      },
      "required": [
        "alias",
        "id",
        "inUse",
        "isDefault",
        "kind",
        "priority",
        "provider",
        "state"
      ],
      "type": "object"
    },
    "InocodeAccountDeepAi": {
      "description": "The DeepAI side of an account: which key it is (never the key), and the Theos balance read from `GET /theos`. Amounts are decimal strings, as the server writes them.",
      "properties": {
        "balance": {
          "default": null,
          "description": "Theos left.",
          "type": [
            "string",
            "null"
          ]
        },
        "balanceStatus": {
          "allOf": [
            {
              "$ref": "#/definitions/InocodeDeepAiBalanceStatus"
            }
          ],
          "description": "`ok`: the balance below is the last read. `notRead`: no read has happened yet. `error`: the last read failed (`error*` say how; a balance, if any, is the last good one)."
        },
        "enabled": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "error": {
          "default": null,
          "description": "Display text (Japanese) of the last failure, naming the code and the HTTP status.",
          "type": [
            "string",
            "null"
          ]
        },
        "errorCode": {
          "default": null,
          "description": "`error.code` of the last failure, when the server gave one.",
          "type": [
            "string",
            "null"
          ]
        },
        "errorStatus": {
          "default": null,
          "description": "HTTP status of the last failure; `0` when there was no answer.",
          "format": "uint16",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "granted": {
          "default": null,
          "description": "Theos the day grants.",
          "type": [
            "string",
            "null"
          ]
        },
        "isPro": {
          "default": null,
          "description": "`null` until it is known (the sign-in answers it; a pasted key learns it on the first usage read).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "keyId": {
          "description": "The first 12 hex characters of `sha256(api_key)`: a way to tell keys apart on screen.",
          "type": "string"
        },
        "refreshAt": {
          "default": null,
          "description": "When the allowance comes back, as the server wrote it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "balanceStatus",
        "keyId"
      ],
      "type": "object"
    },
    "InocodeAccountKind": {
      "description": "Which kind of credential an entry holds. Other providers plug in here later.",
      "oneOf": [
        {
          "enum": [
            "chatgpt",
            "apiKey"
          ],
          "type": "string"
        },
        {
          "description": "A Claude (Pro/Max) OAuth sign-in.",
          "enum": [
            "claudeOauth"
          ],
          "type": "string"
        }
      ]
    },
    "InocodeAccountResetCredit": {
      "description": "`eligible` and the fields after it are present when `status` is `ok`, and also when it is `error` with `stale: true` (the last good value). Otherwise they are absent.",
      "properties": {
        "atLimit": {
          "description": "The account is at a usage limit right now.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cooldownUntil": {
          "description": "Unix seconds; no reset can be spent before this.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "eligible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "endsAt": {
          "description": "Unix seconds; the soonest end among grants with resets left.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "grants": {
          "items": {
            "$ref": "#/definitions/InocodeAccountResetGrant"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "reason": {
          "description": "Why, for `none`, `unavailable` and `error`: a short word such as `block_missing`, `block_null`, `block_unreadable`, `grant_query_refused`, `http_404`, `http_403`, `auth_refused`, `rate_limited`, `request_failed`, `timeout`, `token_unavailable`, `api_key`, `not_read`.",
          "type": [
            "string",
            "null"
          ]
        },
        "resetsLeft": {
          "description": "Resets left across the grants that are not paused.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "resetsTotal": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "stale": {
          "description": "The fields below are the last good value, kept because the latest read failed.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/InocodeResetCreditStatus"
        },
        "usableNow": {
          "description": "A reset can be spent right now.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "InocodeAccountResetGrant": {
      "properties": {
        "clears": {
          "description": "The windows the grant clears: `five_hour`, `seven_day`, `seven_day_overage_included`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "endsAt": {
          "description": "Unix seconds; `null` when the grant does not expire.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "paused": {
          "type": "boolean"
        },
        "resetsLeft": {
          "format": "int64",
          "type": "integer"
        },
        "resetsTotal": {
          "format": "int64",
          "type": "integer"
        },
        "usableNow": {
          "type": "boolean"
        }
      },
      "required": [
        "clears",
        "id",
        "label",
        "paused",
        "resetsLeft",
        "resetsTotal",
        "usableNow"
      ],
      "type": "object"
    },
    "InocodeAccountState": {
      "enum": [
        "active",
        "cooldown",
        "disabled"
      ],
      "type": "string"
    },
    "InocodeAccountUsage": {
      "properties": {
        "fiveHour": {
          "anyOf": [
            {
              "$ref": "#/definitions/InocodeAccountUsageWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "resetCredit": {
          "allOf": [
            {
              "$ref": "#/definitions/InocodeAccountResetCredit"
            }
          ],
          "description": "The banked usage-limit resets. Never `null`: `status` says whether they could be read."
        },
        "updatedAt": {
          "description": "Unix seconds of the last refresh; `null` when never fetched.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "weekly": {
          "anyOf": [
            {
              "$ref": "#/definitions/InocodeAccountUsageWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "resetCredit"
      ],
      "type": "object"
    },
    "InocodeAccountUsageWindow": {
      "properties": {
        "resetsAt": {
          "description": "Unix seconds.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "usedPercent": {
          "description": "0-100.",
          "format": "double",
          "type": "number"
        },
        "windowMinutes": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "usedPercent"
      ],
      "type": "object"
    },
    "InocodeDeepAiBalanceStatus": {
      "enum": [
        "ok",
        "notRead",
        "error"
      ],
      "type": "string"
    },
    "InocodeResetCreditStatus": {
      "oneOf": [
        {
          "description": "Read. Zero resets is still `ok` (`resetsLeft: 0`).",
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "description": "The account is outside the reset-credit scheme (API keys).",
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "The endpoint does not offer it for this account or plan.",
          "enum": [
            "unavailable"
          ],
          "type": "string"
        },
        {
          "description": "The read failed. The fields below are the last good value when `stale` is true.",
          "enum": [
            "error"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "The account list changed (added, removed, usage refreshed, state changed...).",
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/definitions/InocodeAccount"
      },
      "type": "array"
    }
  },
  "required": [
    "accounts"
  ],
  "title": "InocodeAccountsUpdatedNotification",
  "type": "object"
}